{
	"name": "@bus-tracker/server",
	"main": "dist/index.js",
	"type": "module",
	"private": true,
	"scripts": {
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --output-structure locale-modules --is-server true --is-development false --no-emit-ts-declarations --no-emit-readme --silent",
		"build": "pnpm run paraglide && tsc -b",
		"dev": "pnpm build && pnpm start",
		"package": "pkg",
		"start": "node --env-file-if-exists=.env dist/index.js",
		"test": "vitest --run --exclude dist",
		"test:watch": "vitest --exclude dist",
		"migrations:generate": "drizzle-kit generate",
		"migrations:push": "drizzle-kit push"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-message-format": "^4.6.0",
		"@posthog/cli": "^0.20.1",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@bus-tracker/contracts": "workspace:*",
		"@bus-tracker/redis": "workspace:*",
		"@hono/node-server": "^2.1.11",
		"@modelcontextprotocol/hono": "^2.0.2",
		"@modelcontextprotocol/server": "^2.4.0",
		"@posthog/mcp": "1.6.0",
		"arktype": "^2.2.10",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.19",
		"postgres": "^4.1.1",
		"posthog-node": "^6.0.5",
		"ts-pattern": "^5.9.2",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	}
}
